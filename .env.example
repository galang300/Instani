APP_ENV=development

# Public web config
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
VITE_API_URL=http://localhost:4000

# Node services
API_PORT=4000
REALTIME_PORT=4001
WORKER_CONCURRENCY=4
JWT_SECRET=change-me-for-production
ADMIN_EMAIL=admin@panganterkini.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin Pengelola

# Database and queue
DATABASE_URL=postgresql://pangan:pangan@postgres:5432/panganterkini?schema=public
REDIS_URL=redis://redis:6379

# Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=panganterkini

# WhatsApp provider. Fill one provider for deployment.
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FONNTE_TOKEN=
WABLAS_TOKEN=

# Scraper and ML service
SCRAPER_URL=http://localhost:5000
SCRAPER_PORT=5000
ML_ANOMALY_PORT=5001
BAPANAS_SOURCE_URL=https://panelharga.badanpangan.go.id/
PIHPS_SOURCE_URL=https://www.bi.go.id/hargapangan
PIHPS_AUTO_SYNC=true
PIHPS_SYNC_INTERVAL_SECONDS=900
PIHPS_LOOKBACK_DAYS=8
PIHPS_PROVINCE_ID=16
PIHPS_PROVINCE_NAME=Jawa Timur
PIHPS_REGENCY_ID=
PIHPS_REGENCY_NAME=Semua Kabupaten/Kota
PIHPS_COMCAT_ID=
PIHPS_INCLUDE_CATEGORY_ROWS=true

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_ENABLED=true
