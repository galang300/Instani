{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@panganterkini/config": ["packages/config/src/index.ts"],
      "@panganterkini/shared-types": ["packages/shared-types/src/index.ts"],
      "@panganterkini/validation": ["packages/validation/src/index.ts"],
      "@panganterkini/ui": ["packages/ui/src/index.ts"]
    }
  }
}
